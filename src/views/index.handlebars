<section id="clock">
    <div class="flex flex-col items-center font-soul gap-10 h-full pt-24 mt-2 mb-20">
        <div id="clock" class="card flex-col pb-4 w-[30rem] items-center rounded-2xl text-9xl font-medium text-branco overflow-hidden">
            <div class="text-lg font-marck tracking-[0.2rem] text-branco/80 mt-2">Current Session</div>
            <div id="clock_time" class="-mt-8">{{data.time}}</div>
            <div id="clockIn_list_btn" class="text-xl tracking-widest cursor-pointer text-branco/90 hover:text-roxo-claro">
                View Clock In History
            </div>
        </div>

        <div id="table_box" class="card flex-col w-3/5 p-2 h-[28rem] hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
        
            <div id="buttons_list" class="flex overflow-x-scroll overflow-y-clip p-2">
                <div class="button px-3 pb-2 m-1 rounded-lg text-xl font-semibold bg-roxo-claro text-roxo-escuro hover:text-branco cursor-pointer transition-all duration-200 transform hover:scale-105">All</div>
            </div>

            <div id="clockIn_table" class="text-2xl bg-roxo-claro font-italianno"></div>

        </div>

        <div id="clock_button" class="card cursor-pointer text-4xl font-medium tracking-widest text-branco px-4 py-2 outline-8 hover:bg-roxo-claro/80 hover:font-semibold active:bg-roxo-claro">
            {{#if data.is_running}}
                Stop
            {{else}}
                Start
            {{/if}}
        </div>
    </div>
</section>

<section id="notes">
    <div class="flex justify-center gap-10 my-24">
        <div class="card inline-block h-[23rem] min-h-10 w-96 min-w-8 p-1 ms-8 mt-8">
                <h1 class="font-bold font-soul text-branco text-3xl">Notes:</h1>
                {{!-- <input type="button" class="rounded-md text-roxo-escuro bg-azul" value="New Notes" onclick="new_note()"> --}}
                <form id="notes_form" class="mt-4 h-72 w-full">
                    <textarea id="notes_textarea" class="px-2 text-branco text-xl font-marck tracking-wide resize-none focus:outline-none focus:border-roxo-claro rounded-lg h-full w-full bg-azul bg-opacity-50 border-4 border-roxo-escuro">{{ data.notes }}</textarea>
                </form>
        </div>
    </div>
</section>


<section id="goals">
    <div class="flex justify-center gap-10 my-24">

        <div class="card inline-block h-[23rem] w-max p-1 ms-8 mt-8">
            <div class="flex gap-64">
                <a href="/notes/daily_goals" class="font-extrabold font-soul text-branco text-2xl hover:text-roxo-claro {{#if daily_goals_selected }} border-b-4 border-roxo-escuro{{/if}}">Daily Goals</a>
                <a href="/notes/weekly_goals" class="font-extrabold font-soul text-sky-100 text-2xl hover:text-roxo-claro {{#if weekly_goals_selected }} border-b-4 border-roxo-escuro{{/if}}">Weekly Goals</a>
            </div>

            <div class="flex">

                    <ul id="dailyGoalsList" class="flex-1 list-disc list-inside mt-4 h-72 w-96 overflow-y-auto">
                        {{#each data.daily_goals}}
                            <li data-id="{{ id }}" class="group font-medium text-3xl text-wrap tracking-[0.15em] text-branco">
                                {{!-- <input type="button" class="changeStatusDailyGoal text-branco font-sans text-base" value="[]" onclick="change_status_daily_goal({{ id }})"> --}}
                                <span class="group-has-[a:hover]:line-through group-has-[a:hover]:text-red-800 group-has-[input:hover]:line-through">
                                    {{ this.daily_goals }}
                                </span>
                                <a class="deleteDailyGoal hover:cursor-pointer hover:text-opacity-100 text-red-800 text-opacity-0 group-has-[span:hover]:text-opacity-100 no-underline text-4xl font-extrabold">x</a>
                            </li>
                        {{/each}}
                        <li class="text-branco font-medium text-3xl text-wrap tracking-widest">
                            <input
                                id="daily_goals_input"
                                type="text"
                                placeholder="New daily goal"
                                class="bg-transparent outline-none placeholder:text-gray-400"
                            >
                        </li>
                    </ul>    


                    <ul id="weeklyGoalsList" class="flex-1 list-disc list-inside mt-4 h-72 w-96 overflow-y-auto border-s-4 border-roxo-escuro ps-3">
                        {{#each data.weekly_goals}}
                            <li data-id="{{ id }}" class="group font-medium text-3xl text-wrap tracking-widest text-branco">
                                <span class="group-has-[a:hover]:line-through">
                                    {{ this.weekly_goals }}
                                </span>
                                <a class="deleteWeeklyGoal hover:cursor-pointer text-branco text-opacity-0 group-hover:text-opacity-100 no-underline text-3xl font-extrabold">x</a>

                            </li>
                        {{/each}}
                        <li class="text-branco font-medium text-3xl text-wrap tracking-widest">
                            <input
                                id="weekly_goals_input"
                                type="text"
                                placeholder="New weekly goal"
                                class="bg-transparent outline-none placeholder:text-gray-400"
                            >
                        </li>
                    </ul>
            </div>
            
        </div>
    </div>
</section>

<section id="time">
    <div class="flex flex-col items-center font-soul gap-10 h-full pt-10 mt-56 mb-24">
        <div id="hours_completed" class="card flex-col pb-6 w-[30rem] justify-center items-center rounded-2xl text-9xl font-medium text-branco overflow-hidden">
            <div class="text-lg font-marck tracking-[0.2rem] text-branco/80 mt-3 -mb-6">Hours Completed</div>
            {{data.hours_completed}}
        </div>
        <div id="goal_hours" class="card flex-col pb-6 w-[30rem] justify-center items-center rounded-2xl text-9xl font-medium text-branco overflow-hidden">
            <div class="text-lg font-marck tracking-[0.2rem] text-branco/80 mt-3 -mb-6">Goal Hours</div>
            {{data.goal_hours}}
        </div>
    </div>
</section>


<script src="/scripts/script_goals.js"></script>
<script src="/scripts/script_notes.js"></script>
<script type="module" src="/scripts/script_clock.js"></script>