<div class="opacity-100">    
    <section id="clock">
        <div class="flex flex-col items-center font-soul gap-10 h-full pt-24 mt-2 mb-20">
            <div class="relative flex flex-col items-center">

            <img
                    src="/images/frame_top.png"
                    class="absolute -top-[1.62rem] z-20 pointer-events-none w-[32rem] opacity-95" 
                >
                <img
                    src="/images/frame_bottom.png"
                    class="absolute top-44 z-20 pointer-events-none w-80 opacity-95"
                >

                <div id="clock" class="relative z-10 flex flex-col justify-center mt-4 pb-5 pt-2 w-[35rem] items-center text-9xl font-medium text-white overflow-hidden bg-[linear-gradient(to_right,transparent_0%,rgba(54,46,129,0.7)_10%,rgba(54,46,129,0.7)_90%,transparent_100%)]">
                    <div class="text-lg font-marck tracking-[0.2rem] text-white/80 mt-2">Current Session</div>
                    <div id="clock_time" class="-mt-8">{{data.time}}</div>
                    <div id="clockIn_list_btn" class="text-xl tracking-widest cursor-pointer text-white/90 hover:text-purple-light">
                        View Clock In History
                    </div>
                </div>

            </div>

            <div id="table_box" class="card flex-col w-3/5 p-2 h-[28rem] hidden absolute z-30 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">

                <div id="buttons_list" class="flex overflow-x-scroll overflow-y-clip p-2">
                    <div class="button px-3 pb-2 m-1 rounded-lg text-xl font-semibold bg-purple-light text-purple-dark hover:text-white cursor-pointer transition-all duration-200 transform hover:scale-105">All</div>
                </div>

                <div id="clockIn_table" class="text-2xl bg-purple-light font-italianno"></div>

            </div>

            <div id="clock_button" class="card cursor-pointer text-4xl font-medium tracking-widest text-white mt-6 px-4 py-2 outline-8 hover:bg-purple-light/80 hover:font-semibold active:bg-purple-light">
                {{#if data.is_running}}
                    Stop
                {{else}}

                    Start
                {{/if}}
            </div>
        </div>
    </section>

    <section id="notes">
        <div class="flex justify-center gap-10 my-24">
            <div class="card inline-block h-[23rem] min-h-10 w-96 min-w-8 p-4 ms-8 mt-8">
                    <h1 class="font-bold font-soul text-white text-3xl">Notes:</h1>
                    {{!-- <input type="button" class="rounded-md text-purple-dark bg-azul" value="New Notes" onclick="new_note()"> --}}
                    <form id="notes_form" class="mt-4 h-72 w-full">
                        <textarea id="notes_textarea" class="px-2 text-white text-xl font-marck tracking-wide resize-none focus:outline-none focus:border-purple-light rounded-lg h-full w-full bg-blue-medium bg-opacity-50 border-4 border-purple-dark">{{ data.notes }}</textarea>
                    </form>
            </div>
        </div>
    </section>


    <section id="goals">
        <div class="flex justify-center gap-10 my-24">

            <div class="card inline-block h-[23rem] w-max pl-4 pt-3 ms-8 mt-8">
                <div class="flex gap-64 cursor-default">
                    <div class="font-extrabold font-soul text-white text-2xl border-b-[1px] border-white pb-1 pr-8">Daily Goals</div>
                    <div class="font-extrabold font-soul text-white text-2xl border-b-[1px] border-white pb-1 pr-8">Weekly Goals</div>
                </div>

                <div class="flex">

                        <ul id="dailyGoalsList" class="list-none list-inside mt-4 h-72 w-96 overflow-y-auto">
                            {{#each data.daily_goals}}
                                <li data-id="{{ id }}" class="flex group font-medium text-3xl text-wrap tracking-[0.15em] {{#if this.status }}text-pink-light{{else}}text-white{{/if}}">
                                    <svg data-type="daily_goals" xmlns="http://www.w3.org/2000/svg" class="group-has-[a:hover]:text-pink-darker mt-1.5 mx-2 check_icon_size"
                                        viewBox="0 0 24 24" 
                                        onclick="change_status_goal({{ id }}, this)">
                                    {{#if this.status }}
                                        <g id="completed" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                            <path d="m9 11l3 3l8-8"/>
                                            <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/>
                                        </g>
                                    {{else}}
                                        <g id="not_completed" fill="currentColor">
                                            <path d="M5 21q-.825 0-1.413-.588T3 19V5q0-.825.588-1.413T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.588 1.413T19 21H5Zm0-2h14V5H5v14Z"/>
                                        </g>
                                    {{/if}}
                                    </svg>
                                    <span class="{{#if this.status }} line-through {{/if}} group-has-[a:hover]:line-through group-has-[a:hover]:text-pink-darker group-has-[input:hover]:line-through">
                                        {{ this.daily_goals }}
                                    </span>
                                    <a class="deleteDailyGoal hover:cursor-pointer hover:text-opacity-100 text-pink-darker text-opacity-0 group-has-[span:hover]:text-opacity-100 no-underline text-4xl font-extrabold ml-1">x</a>
                                </li>
                            {{/each}}
                            <li class="flex text-white font-medium text-3xl text-wrap tracking-widest">
                                <svg data-type="daily_goals" xmlns="http://www.w3.org/2000/svg" class=" mt-1.5 mx-2 text-white check_icon_size" 
                                        viewBox="0 0 24 24">
                                    <g id="not_completed" fill="currentColor">
                                        <path d="M5 21q-.825 0-1.413-.588T3 19V5q0-.825.588-1.413T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.588 1.413T19 21H5Zm0-2h14V5H5v14Z"/>
                                    </g>
                                </svg>
                                <input
                                    id="daily_goals_input"
                                    type="text"
                                    placeholder="New daily goal"
                                    class="bg-transparent outline-none placeholder:text-gray-400"
                                >
                            </li>
                        </ul>    


                        <ul id="weeklyGoalsList" class="list-none list-inside mt-4 mr-1 h-72 w-96 overflow-y-auto border-s-4 border-purple-dark ps-3">
                            {{#each data.weekly_goals}}
                                <li data-id="{{ id }}" class="flex group font-medium text-3xl text-wrap tracking-[0.15em] {{#if this.status }}text-pink-light{{else}}text-white{{/if}}">
                                    <svg data-type="weekly_goals" xmlns="http://www.w3.org/2000/svg" class="group-has-[a:hover]:text-pink-darker mt-1.5 mx-2 check_icon_size"
                                        viewBox="0 0 24 24" 
                                        onclick="change_status_goal({{ id }}, this)">
                                    {{#if this.status }}
                                        <g id="completed" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                            <path d="m9 11l3 3l8-8"/>
                                            <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/>
                                        </g>
                                    {{else}}
                                        <g id="not_completed" fill="currentColor">
                                            <path d="M5 21q-.825 0-1.413-.588T3 19V5q0-.825.588-1.413T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.588 1.413T19 21H5Zm0-2h14V5H5v14Z"/>
                                        </g>
                                    {{/if}}
                                    </svg>
                                    <span class="{{#if this.status }} line-through {{/if}} group-has-[a:hover]:line-through group-has-[a:hover]:text-pink-darker group-has-[input:hover]:line-through">
                                        {{ this.weekly_goals }}
                                    </span>
                                    <a class="deleteWeeklyGoal hover:cursor-pointer hover:text-opacity-100 text-pink-darker text-opacity-0 group-has-[span:hover]:text-opacity-100 no-underline text-4xl font-extrabold ml-1">x</a>
                                </li>

                                </li>
                            {{/each}}
                            <li class="flex text-white font-medium text-3xl text-wrap tracking-widest">
                                <svg data-type="weekly_goals" xmlns="http://www.w3.org/2000/svg" class="mt-1.5 mx-2 text-white check_icon_size"
                                    viewBox="0 0 24 24" 
                                    onclick="change_status_goal({{ id }}, this)">
                                    <g id="not_completed" fill="currentColor">
                                        <path d="M5 21q-.825 0-1.413-.588T3 19V5q0-.825.588-1.413T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.588 1.413T19 21H5Zm0-2h14V5H5v14Z"/>
                                    </g>
                                </svg>
                                <input
                                    id="weekly_goals_input"
                                    type="text"
                                    placeholder="New weekly goal"
                                    class="bg-transparent outline-none placeholder:text-gray-400"
                                >
                            </li>
                        </ul>
                </div>
                
            </div>
        </div>
    </section>

    <section id="time">
        <div class="flex flex-col items-center font-soul gap-10 h-full pt-10 mt-56 mb-24">
            <div id="hours_completed" class="card flex-col pb-6 w-[30rem] justify-center items-center rounded-2xl text-9xl font-medium text-white overflow-hidden">
                <div class="text-lg font-marck tracking-[0.2rem] text-white/80 mt-3 -mb-6">Hours Completed</div>
                {{data.hours_completed}}
            </div>
            <div id="goal_hours" class="card flex-col pb-6 w-[30rem] justify-center items-center rounded-2xl text-9xl font-medium text-white overflow-hidden">
                <div class="text-lg font-marck tracking-[0.2rem] text-white/80 mt-3 -mb-6">Goal Hours</div>
                {{data.goal_hours}}
            </div>
        </div>
    </section>
</div>

    <script src="/scripts/script_goals.js"></script>
    <script src="/scripts/script_notes.js"></script>
    <script type="module" src="/scripts/script_clock.js"></script>